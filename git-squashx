#!/usr/bin/env bash
#
# git-squashx — squash with memory
#
# Squashes your commits into one and preserves the originals as local
# tags that never expire, so you can always inspect or restore them.
#
# Author : Cristian Romagnoli <https://github.com/cromagnoli>
# License: MIT
#
# Usage:
#   git squashx --save    [base-branch] ["message"]   (-s)
#   git squashx --peek    [squash-id | sha]            (-p)
#   git squashx --restore [squash-id | sha]            (-r)
#   git squashx --drop    [squash-id | sha]            (-d)
#   git squashx --list    [--branch name]              (-l)
#   git squashx --help                                 (-h)

set -eu

TAG_PREFIX="squash-backup"

# ── helpers ───────────────────────────────────────────────────────────────────

# Printf-based color helpers (POSIX safe, no echo -e)
red()    { printf "\033[0;31m%s\033[0m\n" "$*"; }
green()  { printf "\033[0;32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[0;33m%s\033[0m\n" "$*"; }
blue()   { printf "\033[0;34m%s\033[0m\n" "$*"; }
bold()   { printf "\033[1m%s\033[0m\n" "$*"; }
dim()    { printf "\033[2m%s\033[0m\n" "$*"; }

die() {
  red "error: $*" >&2
  exit 1
}

# ── help ──────────────────────────────────────────────────────────────────────

cmd_help() {
  bold "git squashx — squash with memory"
  echo ""
  echo "  Squashes your commits into one and preserves the originals as local"
  echo "  tags that never expire, so you can always inspect or restore them."
  echo ""
  bold "usage:"
  echo ""
  echo "  git squashx --save    [base-branch] [\"message\"]"
  echo "  git squashx --peek    [squash-id | sha]"
  echo "  git squashx --restore [squash-id | sha]"
  echo "  git squashx --drop    [squash-id | sha]"
  echo "  git squashx --list    [--branch <name>]"
  echo "  git squashx --help"
  echo ""
  bold "options:"
  echo ""
  printf "  %-20s %s\n" "--save,    -s" "squash commits and tag originals (auto-detects base branch)"
  printf "  %-20s %s\n" "--peek,    -p" "inspect original commits of a squash"
  printf "  %-20s %s\n" "--restore, -r" "recreate original commits as a new branch"
  printf "  %-20s %s\n" "--drop,    -d" "undo a squash: reset branch + delete tags (warns if pushed)"
  printf "  %-20s %s\n" "--list,    -l" "list all saved squashes"
  printf "  %-20s %s\n" "--help,    -h" "show this help"
  echo ""
  bold "examples:"
  echo ""
  echo "  git squashx --save \"feat: implement login\"          # auto-detects base branch"
  echo "  git squashx --save main \"feat: implement login\"     # explicit base branch"
  echo "  git squashx --save                                   # auto-detects, no message"
  echo "  git squashx --peek                                   # peeks at HEAD squash"
  echo "  git squashx --peek 7b60cd2                          # peek by SHA"
  echo "  git squashx --restore 7b60cd2                       # restore by SHA"
  echo "  git squashx --drop                                   # undo squash at HEAD"
  echo "  git squashx --drop 7b60cd2                          # undo squash by SHA"
  echo "  git squashx --list --branch feature/login"
  echo ""
  bold "commit message format:"
  echo ""
  echo "  custom-squash-id: squash-backup/feature/login/20260501 - feat: implement login"
  echo ""
  echo "  aaac7e4: implement login form"
  echo "  f98ef04: add form validation"
  echo "  8ce72bf: fix edge case in parser"
  echo ""
}

# ── shared: resolve squash-id from SHA or tag ─────────────────────────────────

resolve_squash_id_from_commit() {
  # custom-squash-id can appear anywhere in the commit message
  git log -1 --format="%B" "$1" \
    | grep "custom-squash-id:" \
    | sed 's/.*custom-squash-id: //' \
    | awk '{print $1}' \
    || true
}

resolve_squash_id() {
  _arg="$1"
  case "$_arg" in
    ${TAG_PREFIX}/*)
      echo "$_arg"
      ;;
    *)
      git rev-parse --verify "$_arg" >/dev/null 2>&1 \
        || die "not a valid SHA or squash-id: $_arg"
      _id=$(resolve_squash_id_from_commit "$_arg")
      [ -n "$_id" ] || die "'$_arg' is not a squash commit (no custom-squash-id found in message)"
      echo "$_id"
      ;;
  esac
}

resolve_squash_id_or_head() {
  if [ -n "${1:-}" ]; then
    resolve_squash_id "$1"
  else
    _id=$(resolve_squash_id_from_commit HEAD)
    [ -n "$_id" ] || die "HEAD is not a squash commit. pass a squash-id or SHA.
run 'git squashx --list' to see all saved squashes."
    echo "$_id"
  fi
}

find_commit_tags_for() {
  _squash_id="$1"
  git tag -l "${TAG_PREFIX}/commits/*" | while IFS= read -r _tag; do
    _group=$(git tag -l --format="%(contents)" "$_tag" \
      | grep "^squash-group:" | awk '{print $2}' || true)
    [ "$_group" = "$_squash_id" ] && echo "$_tag"
  done
}

# ── base branch detection ─────────────────────────────────────────────────────

detect_base_branch() {
  _current="$1"
  _candidates=$(mktemp)

  # Build candidates: base_date  tip_date  dist(zero-padded)  branch_name
  # Skip frozen backup/mirror branches (tip_date == base_date).
  git branch --format='%(refname:short)' | grep -v "^${_current}$" | while IFS= read -r _branch; do
    _base=$(git merge-base HEAD "$_branch" 2>/dev/null) || continue
    _tip=$(git rev-parse "$_branch" 2>/dev/null) || continue
    _base_date=$(git log -1 --format="%ct" "$_base" 2>/dev/null) || continue
    _tip_date=$(git log -1 --format="%ct" "$_tip" 2>/dev/null) || continue
    [ "$_tip_date" != "$_base_date" ] || continue
    _dist=$(git log --oneline "${_base}..${_branch}" 2>/dev/null | grep -c . || true)
    printf '%s %s %05d %s\n' "$_base_date" "$_tip_date" "$_dist" "$_branch"
  done > "$_candidates"

  [ -s "$_candidates" ] || {
    rm -f "$_candidates"
    die "could not detect base branch automatically.
pass it explicitly: git squashx --save <base-branch> \"message\"
example: git squashx --save main \"feat: my feature\""
  }

  # Pass 1: exactly one dist=0 candidate → unambiguous direct parent, pick it.
  _direct_count=$(awk '$3 == "00000"' "$_candidates" | grep -c . || true)
  if [ "$_direct_count" -eq 1 ]; then
    _result=$(awk '$3 == "00000" {print $4}' "$_candidates")
    rm -f "$_candidates"
    blue "-> detected base branch: $_result" >&2
    echo "$_result"
    return
  fi

  # Ambiguous — show all candidates sorted by dist ascending and ask user to choose.
  printf '\n' >&2
  yellow "-> could not auto-detect base branch unambiguously." >&2
  echo "   candidates (sorted by distance):" >&2
  printf '\n' >&2
  _i=1
  sort -k3 -n "$_candidates" | while IFS= read -r _line; do
    _dist_n=$(printf '%s' "$_line" | awk '{print $3 + 0}')
    _name=$(printf '%s' "$_line" | awk '{print $4}')
    printf '   %d) %-40s (%d commits ahead)\n' "$_i" "$_name" "$_dist_n" >&2
    _i=$((_i + 1))
  done
  printf '\n' >&2
  rm -f "$_candidates"
  die "pass it explicitly: git squashx --save <base-branch> \"message\""
}

# ── save ──────────────────────────────────────────────────────────────────────

cmd_save() {
  # Argument parsing:
  # If $1 has no spaces, treat it as the base branch.
  # If $1 has spaces (or is absent), treat it as the message and auto-detect base.
  #
  # Valid call forms:
  #   --save                             auto-detect base, no message
  #   --save "feat: my message"          auto-detect base, with message
  #   --save main                        explicit base, no message
  #   --save main "feat: my message"     explicit base, with message
  if [ -n "${1:-}" ] && [ "${1#* }" = "$1" ]; then
    BASE_BRANCH="$1"
    CUSTOM_MSG="${2:-}"
  else
    BASE_BRANCH=""
    CUSTOM_MSG="${1:-}"
  fi

  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
  TIMESTAMP=$(date +%Y%m%d%H%M%S)

  [ -d ".git" ] || die "not inside a git repository"

  git diff --quiet && git diff --cached --quiet \
    || die "you have uncommitted changes. commit or stash them first."

  if [ -z "$BASE_BRANCH" ]; then
    BASE_BRANCH=$(detect_base_branch "$CURRENT_BRANCH")
  fi

  git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1 \
    || die "base branch '$BASE_BRANCH' not found locally. fetch it first."

  [ "$CURRENT_BRANCH" != "$BASE_BRANCH" ] \
    || die "you are already on '$BASE_BRANCH'. checkout your feature branch first."

  COMMITS=$(git log --reverse --format="%H" "$BASE_BRANCH"..HEAD)
  COMMIT_COUNT=$(printf '%s\n' "$COMMITS" | grep -c . || true)

  [ "$COMMIT_COUNT" -gt 0 ] || die "no commits found between '$BASE_BRANCH' and HEAD"
  [ "$COMMIT_COUNT" -gt 1 ] || die "only 1 commit found — nothing to squash"

  blue "-> found $COMMIT_COUNT commits to squash on '$CURRENT_BRANCH'"
  echo ""

  SQUASH_ID="${TAG_PREFIX}/${CURRENT_BRANCH}/${TIMESTAMP}"

  # Check if any of these commits were already squashed before
  _existing_squash=""
  printf '%s\n' "$COMMITS" | while IFS= read -r sha; do
    _tag="${TAG_PREFIX}/commits/${CURRENT_BRANCH}/${sha}"
    if git rev-parse --verify "refs/tags/$_tag" >/dev/null 2>&1; then
      _group=$(git tag -l --format="%(contents)" "$_tag" \
        | grep "^squash-group:" | awk '{print $2}' || true)
      printf '%s\n' "$_group" > /tmp/sqhx_existing_squash
      break
    fi
  done
  _existing_squash=$(cat /tmp/sqhx_existing_squash 2>/dev/null || true)
  rm -f /tmp/sqhx_existing_squash
  if [ -n "$_existing_squash" ]; then
    die "commits on '$CURRENT_BRANCH' were already squashed before.
  existing squash tag: $_existing_squash

to undo the squash and get your original commits back:
  git squashx --drop $_existing_squash

to inspect before deciding:
  git squashx --peek $_existing_squash"
  fi

  TAG_LIST=""

  printf '%s\n' "$COMMITS" | while IFS= read -r sha; do
    MSG=$(git log -1 --format="%s" "$sha")
    TAG_NAME="${TAG_PREFIX}/commits/${CURRENT_BRANCH}/${sha}"
    git tag -a "$TAG_NAME" "$sha" -m "squash-group: $SQUASH_ID
original-sha: $sha
branch: $CURRENT_BRANCH
message: $MSG
date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    yellow "  tagged: $TAG_NAME"
    TAG_LIST="$TAG_LIST $TAG_NAME"
  done

  echo ""

  SQUASH_MSG_FILE=$(mktemp)

  # Build commit message:
  # [SQ] <custom message>
  #
  # Original commits:
  # - <sha>: <message>
  # ...
  #
  # custom-squash-id: <squash-id>
  if [ -n "$CUSTOM_MSG" ]; then
    printf '[SQ] %s\n' "$CUSTOM_MSG" > "$SQUASH_MSG_FILE"
  else
    printf '[SQ] squash of %s commits from %s\n' "$COMMIT_COUNT" "$CURRENT_BRANCH" > "$SQUASH_MSG_FILE"
  fi

  printf '\nOriginal commits:\n' >> "$SQUASH_MSG_FILE"

  printf '%s\n' "$COMMITS" | while IFS= read -r sha; do
    MSG=$(git log -1 --format="%s" "$sha")
    SHORT_SHA=$(git rev-parse --short "$sha")
    printf '%s\n' "- $SHORT_SHA: $MSG" >> "$SQUASH_MSG_FILE"
  done

  printf '\ncustom-squash-id: %s\n' "$SQUASH_ID" >> "$SQUASH_MSG_FILE" 

  MERGE_BASE=$(git merge-base "$BASE_BRANCH" HEAD)

  STASH_RESULT=$(git stash 2>/dev/null || true)
  case "$STASH_RESULT" in
    *"No local changes"*) STASHED=0 ;;
    *) STASHED=1 ;;
  esac

  git reset --soft "$MERGE_BASE"
  git commit -F "$SQUASH_MSG_FILE"
  rm -f "$SQUASH_MSG_FILE"

  [ "$STASHED" -eq 1 ] && git stash pop

  SQUASH_SHA=$(git rev-parse HEAD)
  ORIGINAL_TIP=$(printf '%s\n' "$COMMITS" | tail -1)

  git tag -a "${SQUASH_ID}" "$SQUASH_SHA" -m "squash commit: $SQUASH_SHA
branch: $CURRENT_BRANCH
base: $BASE_BRANCH
original-count: $COMMIT_COUNT
original-tip: $ORIGINAL_TIP
original-tags: $TAG_LIST"

  echo ""
  green "done: squash complete"
  echo ""
  echo "  squash sha : $SQUASH_SHA"
  echo "  squash id  : $SQUASH_ID"
  echo "  originals  : $COMMIT_COUNT commits preserved as local tags"
  echo ""
  yellow "next steps:"
  printf "  git rebase %s\n" "$BASE_BRANCH   # rebase onto $BASE_BRANCH"
  echo "  git squashx --peek $SQUASH_SHA       # inspect original commits"
}

# ── peek ──────────────────────────────────────────────────────────────────────

cmd_peek() {
  SQUASH_ID=$(resolve_squash_id_or_head "${1:-}")

  git rev-parse --verify "refs/tags/$SQUASH_ID" >/dev/null 2>&1 \
    || die "squash tag not found: $SQUASH_ID
run 'git squashx --list' to see all saved squashes."

  COMMIT_TAGS=$(find_commit_tags_for "$SQUASH_ID")
  [ -n "$COMMIT_TAGS" ] || die "no original commit tags found for squash: $SQUASH_ID"

  COUNT=$(printf '%s\n' "$COMMIT_TAGS" | grep -c . || true)

  bold "squash: $SQUASH_ID"
  echo ""
  blue "-> $COUNT original commits:"
  echo ""

  INDEX=1
  printf '%s\n' "$COMMIT_TAGS" | while IFS= read -r tag; do
    SHA=$(git rev-parse "$tag")
    MSG=$(git log -1 --format="%s" "$SHA")
    AUTHOR=$(git log -1 --format="%an" "$SHA")
    DATE=$(git log -1 --format="%ad" --date=short "$SHA")

    bold "[$INDEX/$COUNT] $MSG"
    dim "    $SHA  $AUTHOR  $DATE"
    echo ""

    git show "$SHA" --stat --no-color | tail -n +2 | head -20
    echo ""
    echo "--------------------------------------------"
    echo ""

    INDEX=$((INDEX + 1))
  done

  echo ""
  echo "to see the full diff of a specific commit:"
  echo "  git show <sha>"
}

# ── restore ───────────────────────────────────────────────────────────────────

cmd_restore() {
  SQUASH_ID=$(resolve_squash_id_or_head "${1:-}")

  git rev-parse --verify "refs/tags/$SQUASH_ID" >/dev/null 2>&1 \
    || die "squash tag not found: $SQUASH_ID"

  ORIGINAL_BRANCH=$(git tag -l --format="%(contents)" "$SQUASH_ID" \
    | grep "^branch:" | awk '{print $2}' || true)
  BASE_BRANCH=$(git tag -l --format="%(contents)" "$SQUASH_ID" \
    | grep "^base:" | awk '{print $2}' || true)

  [ -n "$ORIGINAL_BRANCH" ] || die "could not read original branch from tag metadata"
  [ -n "$BASE_BRANCH" ]     || BASE_BRANCH="staging"

  COMMIT_TAGS=$(find_commit_tags_for "$SQUASH_ID")
  [ -n "$COMMIT_TAGS" ] || die "no original commit tags found for: $SQUASH_ID"

  COUNT=$(printf '%s\n' "$COMMIT_TAGS" | grep -c . || true)
  RESTORE_BRANCH="restore/${ORIGINAL_BRANCH}/$(date +%Y%m%d%H%M%S)"

  blue "-> restoring $COUNT commits onto '$BASE_BRANCH'"
  yellow "  new branch: $RESTORE_BRANCH"
  echo ""

  git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1 \
    || die "base branch '$BASE_BRANCH' not found locally. fetch it first."

  git checkout -b "$RESTORE_BRANCH" "$BASE_BRANCH"

  INDEX=1
  printf '%s\n' "$COMMIT_TAGS" | while IFS= read -r tag; do
    SHA=$(git rev-parse "$tag")
    MSG=$(git log -1 --format="%s" "$SHA")
    bold "  [$INDEX/$COUNT] cherry-picking: $MSG"

    if ! git cherry-pick "$SHA" --allow-empty; then
      echo ""
      red "conflict during cherry-pick of commit $INDEX: $MSG"
      echo ""
      echo "resolve the conflict, then run:"
      echo "  git cherry-pick --continue"
      exit 1
    fi

    INDEX=$((INDEX + 1))
  done

  echo ""
  green "done: restore complete"
  echo ""
  echo "  branch  : $RESTORE_BRANCH"
  echo "  commits : $COUNT"
  echo ""
  yellow "you are now on '$RESTORE_BRANCH'"
  echo "to go back to your squashed branch:"
  echo "  git checkout $ORIGINAL_BRANCH"
}

# ── list ──────────────────────────────────────────────────────────────────────

cmd_list() {
  FILTER_BRANCH="${1:-}"

  SQUASH_TAGS=$(git tag -l "${TAG_PREFIX}/*" | grep -v "^${TAG_PREFIX}/commits/" || true)

  if [ -z "$SQUASH_TAGS" ]; then
    echo ""
    dim "  no squashes saved yet."
    echo ""
    echo "  run 'git squashx --save' on a feature branch to get started."
    return
  fi

  echo ""
  bold "saved squashes:"
  echo ""

  COUNT=0
  printf '%s\n' "$SQUASH_TAGS" | while IFS= read -r tag; do
    CONTENTS=$(git tag -l --format="%(contents)" "$tag")
    BRANCH=$(printf '%s\n' "$CONTENTS" | grep "^branch:"        | awk '{print $2}' || true)
    BASE=$(printf '%s\n'   "$CONTENTS" | grep "^base:"           | awk '{print $2}' || true)
    N=$(printf '%s\n'      "$CONTENTS" | grep "^original-count:" | awk '{print $2}' || true)
    SHA=$(printf '%s\n'    "$CONTENTS" | grep "^squash commit:"  | awk '{print $3}' || true)
    DATE=$(git tag -l --format="%(creatordate:short)" "$tag")

    [ -n "$FILTER_BRANCH" ] && [ "$BRANCH" != "$FILTER_BRANCH" ] && continue

    COUNT=$((COUNT + 1))
    green "  $tag"
    echo "    branch   : $BRANCH  ->  $BASE"
    echo "    commits  : $N original commits"
    echo "    sha      : ${SHA:-n/a}"
    echo "    saved on : $DATE"
    echo ""
    dim "    git squashx --peek $tag"
    dim "    git squashx --restore $tag"
    dim "    git squashx --drop $tag"
    echo ""
  done

  if [ "$COUNT" -eq 0 ] && [ -n "$FILTER_BRANCH" ]; then
    dim "  no squashes found for branch '$FILTER_BRANCH'"
    echo ""
  fi
}

# ── drop ──────────────────────────────────────────────────────────────────────

cmd_drop() {
  SQUASH_ID=$(resolve_squash_id_or_head "${1:-}")

  git rev-parse --verify "refs/tags/$SQUASH_ID" >/dev/null 2>&1 \
    || die "squash tag not found: $SQUASH_ID
run 'git squashx --list' to see all saved squashes."

  CONTENTS=$(git tag -l --format="%(contents)" "$SQUASH_ID")
  SQUASH_SHA=$(printf '%s\n' "$CONTENTS" | grep "^squash commit:" | awk '{print $3}' || true)
  ORIGINAL_TIP=$(printf '%s\n' "$CONTENTS" | grep "^original-tip:" | awk '{print $2}' || true)
  ORIGINAL_BRANCH=$(printf '%s\n' "$CONTENTS" | grep "^branch:" | awk '{print $2}' || true)

  [ -n "$SQUASH_SHA" ]      || die "could not read squash commit SHA from tag metadata"
  [ -n "$ORIGINAL_BRANCH" ] || die "could not read branch from tag metadata"

  COMMIT_TAGS=$(find_commit_tags_for "$SQUASH_ID")
  COMMIT_COUNT=$(printf '%s\n' "$COMMIT_TAGS" | grep -c . || true)

  # Check if squash commit has been pushed to any remote
  _on_remote=$(git branch -r --contains "$SQUASH_SHA" 2>/dev/null | head -1 || true)

  if [ -n "$_on_remote" ]; then
    yellow "-> warning: squash commit has been pushed to remote (${_on_remote# })." >&2
    echo "   resetting the branch would require a force push — skipping reset." >&2
    echo "   deleting local tags only." >&2
    echo ""
  fi

  # Delete per-commit tags
  printf '%s\n' "$COMMIT_TAGS" | while IFS= read -r _tag; do
    git tag -d "$_tag"
  done

  # Delete summary tag
  git tag -d "$SQUASH_ID"

  # Reset branch to original tip only if not pushed
  if [ -z "$_on_remote" ]; then
    [ -n "$ORIGINAL_TIP" ] || die "original-tip not found in tag metadata.
this squash was created with an older version of squashx — use --restore instead."

    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    [ "$CURRENT_BRANCH" = "$ORIGINAL_BRANCH" ] \
      || die "you are on '$CURRENT_BRANCH', but this squash belongs to '$ORIGINAL_BRANCH'.
checkout '$ORIGINAL_BRANCH' first, then run --drop."

    git reset --hard "$ORIGINAL_TIP"
    echo ""
    green "done: squash dropped"
    echo ""
    echo "  branch reset to : $ORIGINAL_TIP"
    echo "  tags deleted    : $((COMMIT_COUNT + 1))  ($COMMIT_COUNT commits + summary)"
  else
    echo ""
    green "done: squash tags deleted"
    echo ""
    echo "  tags deleted : $((COMMIT_COUNT + 1))  ($COMMIT_COUNT commits + summary)"
    echo ""
    yellow "  note: squash commit $SQUASH_SHA is still on the remote."
    echo "  to fully revert, force push after resetting locally:"
    echo "    git reset --hard $ORIGINAL_TIP"
    echo "    git push --force-with-lease"
  fi
}

# ── entrypoint ────────────────────────────────────────────────────────────────

CMD="${1:-}"

case "$CMD" in
  --save    | -s) shift; cmd_save    "$@" ;;
  --peek    | -p) shift; cmd_peek    "${1:-}" ;;
  --restore | -r) shift; cmd_restore "${1:-}" ;;
  --drop    | -d) shift; cmd_drop    "${1:-}" ;;
  --list    | -l)
    shift
    BRANCH_FILTER=""
    [ "${1:-}" = "--branch" ] && BRANCH_FILTER="${2:-}"
    cmd_list "$BRANCH_FILTER"
    ;;
  --help | -h) cmd_help ;;
  "")          cmd_help ;;
  *) die "unknown command: $CMD
run 'git squashx --help' for usage." ;;
esac
